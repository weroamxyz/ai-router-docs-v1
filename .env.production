# RoamAI brand identity — loaded automatically by `next build` on the roam/develop
# branch, so this branch renders as RoamAI everywhere (Vercel and local) with no
# extra dashboard config. Only NON-SECRET NEXT_PUBLIC_* brand values belong here;
# secrets (OPENAI_API_KEY, INKEEP_API_KEY, GITHUB_*, ...) stay in the Vercel project
# env — see env.example. The default `develop` branch has no such file and stays
# Unode/算力仓.
NEXT_PUBLIC_SITE_BASE_URL=https://ai.weroam.xyz
NEXT_PUBLIC_BRAND_NAME=RoamAI
NEXT_PUBLIC_LOGO_SRC=/assets/logo-roamai.png
NEXT_PUBLIC_SUPPORT_EMAIL=support@weroam.xyz
# Browser-tab icon. RoamAI's favicon image is identical to its logo, so we reuse
# the same asset (PNG favicons are supported by modern browsers).
NEXT_PUBLIC_FAVICON=/assets/logo-roamai.png
