# RoamAI brand preset
# =============================================================================
# This file documents the environment variables that switch the docs site to
# the RoamAI brand. The same codebase/content serves both Unode (算力仓, the
# default) and RoamAI — only these vars differ.
#
# On Vercel: set these in the RoamAI project's Environment Variables (Production
# + Preview). For local testing: copy the values into .env.local.
# All other vars (OPENAI_API_KEY, INKEEP_API_KEY, GITHUB_*, etc.) are shared —
# see env.example.
# =============================================================================

# Site base URL — used in console links, metadata, and all docs API examples
NEXT_PUBLIC_SITE_BASE_URL=https://ai.weroam.xyz

# Brand display name — applied to every locale (RoamAI has no separate zh name)
NEXT_PUBLIC_BRAND_NAME=RoamAI

# Logo shown in the navbar and metadata (committed at public/assets/logo-roamai.png)
NEXT_PUBLIC_LOGO_SRC=/assets/logo-roamai.png

# Support email shown on the business pages.
# Support email shown on the business pages (provisional — update if it changes).
NEXT_PUBLIC_SUPPORT_EMAIL=support@weroam.xyz
